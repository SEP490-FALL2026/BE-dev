{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "healthGetLiveness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The API process is alive.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponseDto" } } }
          },
          "500": {
            "description": "The liveness check could not be completed.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["health"]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "healthGetReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every required dependency is reachable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReadinessResponseDto" } } }
          },
          "500": {
            "description": "The readiness check could not be completed.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "A required dependency is unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["health"]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "authLogin",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginBodyDto" } } }
        },
        "responses": {
          "200": {
            "description": "Signed in. The refresh token is set as an HttpOnly cookie.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionTokenResponseDto" } } }
          },
          "401": {
            "description": "The email or password is not valid (one answer for every reason).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "422": {
            "description": "The request body is invalid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "429": {
            "description": "Too many failed attempts; see retryAfterSeconds.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The database is temporarily unavailable. Retry shortly.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "authRefresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "A new access token; the refresh cookie is rotated.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionTokenResponseDto" } } }
          },
          "401": {
            "description": "The session is missing, expired, revoked or replayed. The cookie is cleared.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "The database is temporarily unavailable. Retry shortly.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "authLogout",
        "parameters": [],
        "responses": {
          "204": { "description": "Signed out (or there was nothing to sign out)." },
          "503": {
            "description": "The database is temporarily unavailable. Retry shortly.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["auth"]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "meGet",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The signed-in account, its employee record and its effective roles.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponseDto" } } }
          },
          "401": {
            "description": "Authentication is required or the token is no longer valid.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          },
          "503": {
            "description": "Authentication is temporarily unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeDto" } } }
          }
        },
        "summary": "",
        "tags": ["me"]
      }
    }
  },
  "info": {
    "title": "Software License Management API",
    "description": "Internal software license and technology cost API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": { "bearer": { "scheme": "bearer", "bearerFormat": "JWT", "type": "http" } },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "message": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z0-9_]+)+$" },
          "data": {
            "type": "object",
            "properties": { "status": { "type": "string", "enum": ["ok"] } },
            "required": ["status"],
            "additionalProperties": false,
            "nullable": true
          }
        },
        "required": ["success", "message", "data"],
        "additionalProperties": false
      },
      "ErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z0-9_]+)*$" },
              "message": { "type": "string" },
              "details": { "type": "object", "properties": {}, "additionalProperties": {} },
              "requestId": { "type": "string", "minLength": 1 }
            },
            "required": ["code", "message", "requestId"],
            "additionalProperties": false
          }
        },
        "required": ["success", "error"],
        "additionalProperties": false
      },
      "ReadinessResponseDto": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "message": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z0-9_]+)+$" },
          "data": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "enum": ["ready"] },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "name": { "type": "string" }, "status": { "type": "string" } },
                  "required": ["name", "status"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["status", "checks"],
            "additionalProperties": false,
            "nullable": true
          }
        },
        "required": ["success", "message", "data"],
        "additionalProperties": false
      },
      "LoginBodyDto": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "maxLength": 254 },
          "password": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "required": ["email", "password"],
        "additionalProperties": false
      },
      "SessionTokenResponseDto": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "message": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z0-9_]+)+$" },
          "data": {
            "type": "object",
            "properties": {
              "accessToken": { "type": "string" },
              "tokenType": { "type": "string", "enum": ["Bearer"] },
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              }
            },
            "required": ["accessToken", "tokenType", "expiresAt"],
            "additionalProperties": false,
            "nullable": true
          }
        },
        "required": ["success", "message", "data"],
        "additionalProperties": false
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "message": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z0-9_]+)+$" },
          "data": {
            "type": "object",
            "properties": {
              "appUserId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "loginEmail": { "type": "string" },
              "employee": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "employeeCode": { "type": "string" },
                  "fullName": { "type": "string" },
                  "department": {
                    "type": "object",
                    "properties": { "code": { "type": "string" }, "name": { "type": "string" } },
                    "required": ["code", "name"],
                    "additionalProperties": false,
                    "nullable": true
                  },
                  "jobTitle": { "type": "string", "nullable": true }
                },
                "required": ["id", "employeeCode", "fullName", "department", "jobTitle"],
                "additionalProperties": false
              },
              "roles": {
                "type": "object",
                "properties": {
                  "direct": { "type": "array", "items": { "type": "string" } },
                  "derived": { "type": "array", "items": { "type": "string" } },
                  "effective": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["direct", "derived", "effective"],
                "additionalProperties": false
              },
              "selfServiceOnly": { "type": "boolean" }
            },
            "required": ["appUserId", "loginEmail", "employee", "roles", "selfServiceOnly"],
            "additionalProperties": false,
            "nullable": true
          }
        },
        "required": ["success", "message", "data"],
        "additionalProperties": false
      }
    }
  }
}
