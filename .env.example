NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# How many reverse-proxy hops sit in front of this process. Two behaviours depend on it:
#   - Rate limiting keys on req.ip, which Express derives from this setting. Behind a proxy
#     with 0 hops every client is seen as the proxy, so the whole user base shares one
#     RATE_LIMIT_LIMIT bucket.
#   - An inbound x-request-id is believed only when this is greater than 0. Without a proxy
#     the header is untrusted input, and honouring it would let any caller pin every request
#     to one correlation id or reuse one from somebody else's audit trail.
TRUST_PROXY_HOPS=0
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
SWAGGER_ENABLED=true

# Development and production use this database as given.
DATABASE_URL=postgresql://app:app@localhost:5432/software_license_management
# NODE_ENV=test appends _test to the database name above, so a suite that truncates rows can
# never do it to the database you are developing against. Set TEST_DATABASE_URL to override.
# TEST_DATABASE_URL=postgresql://app:app@localhost:5432/software_license_management_test
# `pnpm test:integration` creates a throwaway slm_<nonce>_test database per run and drops it afterwards.
# Point this at a localhost PostgreSQL role that may create databases (never a shared server). When
# unset it falls back to TEST_DATABASE_URL, then DATABASE_URL, with the database name set to `postgres`.
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:<password>@localhost:5432/postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
# Required in production: Redis holds queue payloads and rate-limit state, so an
# unauthenticated instance is readable and writable by anything that reaches its network.
REDIS_PASSWORD=
REDIS_TLS=false

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=software-license-files
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true

OIDC_ISSUER=http://localhost:8080/realms/software-license-management
OIDC_AUDIENCE=software-license-api
OIDC_JWKS_URI=http://localhost:8080/realms/software-license-management/protocol/openid-connect/certs
