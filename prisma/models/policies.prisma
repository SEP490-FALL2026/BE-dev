// The policy library (`QĐ-111ao`, `QĐ-111bi`): a fixed set of policies per organization, each with published versions that are
// never changed and at most one draft, and the acknowledgement a reader gave of a version. Partial unique indexes, CHECKs
// and the triggers that keep a published version and an acknowledgement as they were are SQL in the migration (ADR-0005).
// `employee_id` and `app_user_id` are values, not foreign keys: the people belong to other modules.

model Policy {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  versions PolicyVersion[]

  @@unique([organizationId, code])
  @@map("policies")
}

// `version_number` is null while the row is the draft. Publishing fills it in, with the time, the person and the ground of
// the issue; from then on a trigger refuses any change and any delete.
model PolicyVersion {
  id                        String    @id @default(uuid(7)) @db.Uuid
  organizationId            String    @map("organization_id") @db.Uuid
  policyId                  String    @map("policy_id") @db.Uuid
  versionNumber             Int?      @map("version_number")
  title                     String
  content                   Json
  applicableRoles           AppRole[] @map("applicable_roles")
  changeNote                String?   @map("change_note")
  requiresReacknowledgement Boolean   @default(true) @map("requires_reacknowledgement")
  draftedByAppUserId        String?   @map("drafted_by_app_user_id") @db.Uuid
  publishedByAppUserId      String?   @map("published_by_app_user_id") @db.Uuid
  publishedAt               DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  policy           Policy                  @relation(fields: [policyId], references: [id], onDelete: Restrict)
  acknowledgements PolicyAcknowledgement[]

  @@unique([policyId, versionNumber])
  @@map("policy_versions")
}

model PolicyAcknowledgement {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  policyVersionId String   @map("policy_version_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  appUserId       String   @map("app_user_id") @db.Uuid
  acknowledgedAt  DateTime @default(now()) @map("acknowledged_at") @db.Timestamptz(3)

  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@unique([policyVersionId, appUserId])
  @@index([organizationId, employeeId])
  @@index([appUserId, policyVersionId])
  @@map("policy_acknowledgements")
}
