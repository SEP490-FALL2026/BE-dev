enum LicenseAssignmentStatus {
  ACTIVE
  REVOKED
}

model LicensePool {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @db.Uuid
  name          String
  totalSeats    Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  application   CatalogApplication  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  assignments   LicenseAssignment[]

  @@unique([applicationId, name])
  @@index([applicationId])
  @@map("license_pools")
}

model LicenseAssignment {
  id         String                  @id @default(uuid()) @db.Uuid
  poolId     String                  @db.Uuid
  employeeId String                  @db.Uuid
  status     LicenseAssignmentStatus @default(ACTIVE)
  assignedAt DateTime                @default(now())
  revokedAt  DateTime?
  pool       LicensePool             @relation(fields: [poolId], references: [id], onDelete: Restrict)
  employee   Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([poolId, employeeId])
  @@index([employeeId, status])
  @@map("license_assignments")
}
