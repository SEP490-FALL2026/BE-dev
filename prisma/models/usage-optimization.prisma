model UsageRecord {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  externalUser  String
  periodStart   DateTime
  periodEnd     DateTime
  activeDays    Int
  importedAt    DateTime           @default(now())
  application   CatalogApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([applicationId, externalUser, periodStart, periodEnd])
  @@index([applicationId, periodEnd])
  @@map("usage_records")
}
