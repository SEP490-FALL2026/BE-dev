model Department {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]

  @@map("departments")
}

model Employee {
  id                    String                 @id @default(uuid()) @db.Uuid
  employeeCode          String                 @unique
  principalId           String?                @unique @db.Uuid
  departmentId          String?                @db.Uuid
  managerId             String?                @db.Uuid
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  principal             Principal?             @relation(fields: [principalId], references: [id], onDelete: SetNull)
  department            Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager               Employee?              @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports         Employee[]             @relation("EmployeeManager")
  licenseAssignments    LicenseAssignment[]
  requestedAccess       AccessRequest[]        @relation("AccessRequester")
  approvalSteps         ApprovalStep[]         @relation("ApprovalAssignee")
  financialTransactions FinancialTransaction[]

  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}
