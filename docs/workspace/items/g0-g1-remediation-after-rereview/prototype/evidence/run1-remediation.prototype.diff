diff --git a/src/infrastructure/database/pg-pool.ts b/src/infrastructure/database/pg-pool.ts
new file mode 100644
index 0000000..a52d76a
--- /dev/null
+++ b/src/infrastructure/database/pg-pool.ts
@@ -0,0 +1,64 @@
+import { Client, type ClientConfig, Pool, type PoolConfig } from 'pg';
+
+/** What node-postgres reports when `query_timeout` fires (pg 8.23, lib/client.js). */
+const CLIENT_QUERY_TIMEOUT = 'Query read timeout';
+
+type QueryCallback = (error: Error | null, result?: unknown) => void;
+
+/**
+ * A pooled connection that takes itself out of service as soon as one of its queries hits the
+ * client-side `query_timeout`.
+ *
+ * pg only rejects the call when that timer fires: the statement stays active on the connection and
+ * an open transaction stays open. The Prisma adapter then releases the connection to the pool without
+ * an error, and the next request would run — and commit — inside that transaction (review N-1).
+ * `end()` on a connection with an active query destroys the socket (non-pipeline branch of
+ * `Client.end`), so PostgreSQL rolls the transaction back as soon as it reads again, and pg-pool drops
+ * an ending connection on release instead of reusing it.
+ */
+export class RetireOnTimeoutClient extends Client {
+  constructor(config?: string | ClientConfig) {
+    super(config);
+    const query = super.query.bind(this) as (...args: unknown[]) => unknown;
+    // An own property keeps every overload of Client.query for callers; only the outcome is observed.
+    this.query = ((...args: unknown[]): unknown => {
+      const last = args.length - 1;
+      if (typeof args[last] === 'function') {
+        const callback = args[last] as QueryCallback;
+        args[last] = (error: Error | null, result?: unknown): void => {
+          this.retireAfter(error);
+          callback(error, result);
+        };
+      }
+      const result = query(...args);
+      if (result instanceof Promise) {
+        return result.catch((error: unknown) => {
+          this.retireAfter(error);
+          throw error;
+        });
+      }
+      return result;
+    }) as Client['query'];
+  }
+
+  /** Called once when this connection retires itself; the pool factory wires it to a log. */
+  protected onRetired(): void {}
+
+  private retireAfter(error: unknown): void {
+    if (error instanceof Error && error.message === CLIENT_QUERY_TIMEOUT) {
+      this.onRetired();
+      this.end().catch(() => undefined);
+    }
+  }
+}
+
+/** The pool behind Prisma: same settings as before, with connections that retire on a client-side timeout. */
+export function createPostgresPool(config: PoolConfig, hooks: { onRetire?: () => void } = {}): Pool {
+  class PooledClient extends RetireOnTimeoutClient {
+    protected override onRetired(): void {
+      hooks.onRetire?.();
+    }
+  }
+
+  return new Pool({ ...config, Client: PooledClient });
+}
