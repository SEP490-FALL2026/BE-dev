diff --git a/test/integration/licensing/seat-reduction-guards.integration-spec.ts b/test/integration/licensing/seat-reduction-guards.integration-spec.ts
new file mode 100644
index 000000000..289956e68
--- /dev/null
+++ b/test/integration/licensing/seat-reduction-guards.integration-spec.ts
@@ -0,0 +1,163 @@
+import request from 'supertest';
+import { Barrier } from '../../support/concurrency-harness';
+import { pretendBusinessToday } from '../../support/pretend-today';
+import { RevocationHarness } from '../../support/revocation-harness';
+
+const h = new RevocationHarness();
+const TODAY = '2026-11-21';
+
+interface LineRow {
+  id: string;
+  updated_at: Date;
+}
+
+/**
+ * The guards of the ledger of the seats of a line against taking seats away, on real PostgreSQL and through the routes: a correction or a
+ * reduction never leaves fewer seats than the seats taken (`SEAT_LEDGER.BELOW_OCCUPANCY`, also when a grant and a reduction race for the
+ * last free seat), a mid-term reduction needs the period to allow it (`SEAT_LEDGER.MID_TERM_REDUCTION_NOT_ALLOWED`), and the reductions of one
+ * purchase never add up to more than it bought (`SEAT_LEDGER.REDUCTION_EXCEEDS_PURCHASE`).
+ */
+describe('the guards of a reduction of the seats of a line (integration, real PostgreSQL)', () => {
+  let counter = 0;
+  const code = () => `E-SRG-${(counter += 1)}`;
+
+  beforeAll(async () => {
+    await h.start();
+    pretendBusinessToday(h.ctx.app, TODAY);
+  }, 300000);
+
+  afterAll(async () => {
+    await h.stop();
+  });
+
+  const lineOf = async (subscriptionId: string): Promise<LineRow> =>
+    (
+      await h.ctx.sql.query<LineRow>(
+        'SELECT id, updated_at FROM subscription_lines WHERE subscription_id = $1 ORDER BY created_at LIMIT 1',
+        [subscriptionId],
+      )
+    ).rows[0];
+  const seatsOf = async (lineId: string): Promise<number> =>
+    (
+      await h.ctx.sql.query<{ seats: number }>(
+        'SELECT COALESCE(sum(delta), 0)::int AS seats FROM seat_changes WHERE subscription_line_id = $1',
+        [lineId],
+      )
+    ).rows[0].seats;
+  const occupiedOf = async (subscriptionId: string): Promise<number> =>
+    (
+      await h.ctx.sql.query<{ taken: number }>(
+        `SELECT count(*)::int AS taken FROM license_assignments
+          WHERE subscription_id = $1 AND failed_at IS NULL AND cancelled_at IS NULL AND (valid_until IS NULL OR valid_until > $2::date)`,
+        [subscriptionId, TODAY],
+      )
+    ).rows[0].taken;
+  const correct = (line: LineRow, delta: number) =>
+    request(h.server()).post(`/api/v1/subscription-lines/${line.id}/seat-corrections`).set(h.as(h.it1)).send({
+      delta,
+      effectiveOn: TODAY,
+      note: 'vendor changed the seats',
+      expectedUpdatedAt: line.updated_at.toISOString(),
+    });
+  const reduce = (line: LineRow, refundedSeatChangeId: string, quantity: number) =>
+    request(h.server()).post(`/api/v1/subscription-lines/${line.id}/seat-reductions`).set(h.as(h.it1)).send({
+      refundedSeatChangeId,
+      quantity,
+      effectiveOn: TODAY,
+      note: 'vendor refunded the seats',
+      expectedUpdatedAt: line.updated_at.toISOString(),
+    });
+  const initialChangeOf = async (lineId: string): Promise<string> =>
+    (
+      await h.ctx.sql.query<{ id: string }>(
+        `SELECT id FROM seat_changes WHERE subscription_line_id = $1 AND reason = 'INITIAL' ORDER BY effective_on LIMIT 1`,
+        [lineId],
+      )
+    ).rows[0].id;
+
+  it('refuses 409 SEAT_LEDGER.BELOW_OCCUPANCY a correction that leaves fewer seats than the seats taken, and writes nothing', async () => {
+    const subscriptionId = await h.subscription(3, 'K2');
+    await h.seat({ subscriptionId }, code());
+    await h.seat({ subscriptionId }, code());
+    const line = await lineOf(subscriptionId);
+
+    const refused = await correct(line, -2);
+
+    expect(refused.status).toBe(409);
+    expect(h.codeOf(refused)).toBe('SEAT_LEDGER.BELOW_OCCUPANCY');
+    expect(await seatsOf(line.id)).toBe(3);
+    const allowed = await correct(line, -1);
+    expect(allowed.status).toBe(201);
+    expect(await seatsOf(line.id)).toBe(2);
+  });
+
+  it('20x barrier: a grant and a reduction racing for the last free seat never both succeed, and the seats never fall below the seats taken', async () => {
+    const subscriptionId = await h.subscription(3, 'K2');
+    const planId = await h.planOf(subscriptionId);
+    await h.seat({ subscriptionId }, code());
+    await h.seat({ subscriptionId }, code());
+    const outcomes: string[] = [];
+
+    for (let round = 0; round < 20; round += 1) {
+      // One seat is free at the start of every round: the one that was just taken or taken away is bought again.
+      let line = await lineOf(subscriptionId);
+      if ((await seatsOf(line.id)) === (await occupiedOf(subscriptionId))) {
+        expect((await correct(line, 1)).status).toBe(201);
+        line = await lineOf(subscriptionId);
+      }
+      const person = await h.person(code());
+      const requestId = h.gate.grantable(person, planId);
+      const barrier = new Barrier(2);
+
+      const [granted, reduced] = await Promise.all([
+        (async () => {
+          await barrier.wait();
+
+          return h.grant({ requestId, subscriptionId });
+        })(),
+        (async () => {
+          await barrier.wait();
+
+          return correct(line, -1);
+        })(),
+      ]);
+
+      expect([granted.status, reduced.status].every((status) => status < 500)).toBe(true);
+      expect([granted.status === 201, reduced.status === 201].filter(Boolean)).toHaveLength(1);
+      const seats = await seatsOf(line.id);
+      const occupied = await occupiedOf(subscriptionId);
+      expect(seats).toBeGreaterThanOrEqual(occupied);
+      outcomes.push(granted.status === 201 ? 'GRANT' : `REDUCE after ${h.codeOf(granted)}`);
+      if (reduced.status !== 201) expect(h.codeOf(reduced)).toBe('SEAT_LEDGER.BELOW_OCCUPANCY');
+    }
+    expect(outcomes).toHaveLength(20);
+  }, 600000);
+
+  it('refuses 409 SEAT_LEDGER.MID_TERM_REDUCTION_NOT_ALLOWED a reduction of a period that does not allow it, and writes nothing', async () => {
+    const subscriptionId = await h.subscription(10, 'K2');
+    const line = await lineOf(subscriptionId);
+    const purchase = await initialChangeOf(line.id);
+
+    const refused = await reduce(line, purchase, 1);
+
+    expect(refused.status).toBe(409);
+    expect(h.codeOf(refused)).toBe('SEAT_LEDGER.MID_TERM_REDUCTION_NOT_ALLOWED');
+    expect(await seatsOf(line.id)).toBe(10);
+  });
+
+  it('refuses 409 SEAT_LEDGER.REDUCTION_EXCEEDS_PURCHASE the reductions of one purchase that add up to more than it bought', async () => {
+    const subscriptionId = await h.subscription(10, 'K2');
+    await h.ctx.sql.query('UPDATE subscriptions SET allows_mid_term_reduction = true WHERE id = $1', [subscriptionId]);
+    let line = await lineOf(subscriptionId);
+    const purchase = await initialChangeOf(line.id);
+
+    expect((await reduce(line, purchase, 4)).status).toBe(201);
+    line = await lineOf(subscriptionId);
+    const refused = await reduce(line, purchase, 7);
+
+    expect(refused.status).toBe(409);
+    expect(h.codeOf(refused)).toBe('SEAT_LEDGER.REDUCTION_EXCEEDS_PURCHASE');
+    expect(h.detailsOf(refused)).toMatchObject({ remaining: 6, requested: 7 });
+    expect(await seatsOf(line.id)).toBe(6);
+  });
+});
